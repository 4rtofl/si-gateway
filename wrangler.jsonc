{
	"$schema": "node_modules/wrangler/config-schema.json",
	// LLM のプロバイダの API を中継し、使用量を記録する Worker。構成: docs/design.md
	"name": "sigw",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// portal.sigw.4rtofl.org: Web UI と API。si.sigw.4rtofl.org: LLM の中継だけ(vars の PROXY_HOST)。
	// cli.sigw.4rtofl.org: CLI のインストールスクリプト(vars の CLI_HOST)。
	// 4rtofl.org は同じアカウントのゾーン。workers.dev でも引き続き使える
	"routes": [
		{ "pattern": "portal.sigw.4rtofl.org", "custom_domain": true },
		{ "pattern": "si.sigw.4rtofl.org", "custom_domain": true },
		{ "pattern": "cli.sigw.4rtofl.org", "custom_domain": true }
	],
	// CLI のインストールスクリプト(cli/install.sh など)を、文字列として Worker に入れる
	"rules": [
		{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": true }
	],
	"workers_dev": true,
	// Web UI(ui/ を Vite でビルドしたもの)。中継だけのドメインで画面を出さないよう、すべてのリクエストを先に Worker が受ける
	"assets": {
		"directory": "./ui/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// 手元(wrangler dev)では、request.url のホストを routes のドメインに書き換えず、localhost のままにする。
	// 書き換えると、Discord のログインから戻る先が本番のドメインになってしまう
	"dev": {
		"port": 8787,
		"host": "localhost:8787"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// LLM の中継だけを受け付けるホスト。ここでは画面・API・ログインを出さない。
		// 「設定」に出すクライアントの base URL も、このホストにする
		"PROXY_HOST": "si.sigw.4rtofl.org",
		// CLI のインストールスクリプトだけを配るホスト(src/web/cli-dist.ts)
		"CLI_HOST": "cli.sigw.4rtofl.org",
		// CLI のバイナリを置く GitHub Releases のリポジトリ(タグは cli-v0.1.0 の形)
		"CLI_RELEASE_REPOSITORY": "4rtofl/si-gateway",
		// Web UI にログインできる Discord のユーザー ID(カンマ区切り)。Org のメンバー3人。
		// Daichoo の台帳の payer_id / debtor_id と同じ ID を使う
		"ALLOWED_DISCORD_IDS": "1148088717907595324,687896063545180253,662108579658203206",
		// Discord の OAuth2 の Client ID(sigw 専用の Discord アプリ。Web UI のログインだけに使う)
		"DISCORD_CLIENT_ID": "1573772492173217794",
		// 精算の記録を書き込む Daichoo のリポジトリ(所有者/リポジトリ名)とブランチ
		"DAICHOO_REPOSITORY": "4rtofl/Daichoo",
		"DAICHOO_BRANCH": "main",
		// 台帳にコミットする GitHub App の Client ID。Daichoo の App をそのまま使うときは、Daichoo の wrangler.jsonc と同じ値
		"GITHUB_APP_CLIENT_ID": "Iv23liUcIsfP5k8hGW1s"
	},
	// 値は .dev.vars に書く(.dev.vars.example を参照)。本番は「pnpm exec wrangler secret put <名前>」で入れる
	"secrets": {
		"required": [
			"DISCORD_CLIENT_SECRET",
			"GITHUB_APP_PRIVATE_KEY",
			"KEY_ENCRYPTION_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sigw",
			"database_id": "8ed67d1d-8e6d-4634-89b8-c854693a98a5",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// 1つ目: 毎日 0:05・3:05・6:05(日本時間)。価格表の同期と、毎月1日の精算(Daichoo の精算 9:17 より前)。
		// 2つ目: 5分ごと。Managed Agents のセッションの使用量を読む(src/index.ts の AGENT_SESSIONS_CRON と同じ文字列にする)
		"crons": ["5 15,18,21 * * *", "*/5 * * * *"]
	}
}
